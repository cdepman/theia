# Server-side only. Never prefix any of these with VITE_ and never commit real values.

# Supabase project (Settings > API). The secret key starts with sb_secret_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# Not used by the app (the browser never talks to Supabase). Kept for reference.
SUPABASE_PUBLISHABLE_KEY=

# Access gate. Generate each with: openssl rand -base64 32
GATE_PASSWORD=
GATE_SIGNING_KEY=

# Shared secret between the scheduled dispatcher and the background worker.
WORKER_SECRET=

# Secret for the external freshness check (GitHub Actions calls /api/data-status with it).
STATUS_CHECK_SECRET=

# Attention signals. X trends and X news stories are paid per request and are skipped
# until this is set. Create a bearer token in the X Developer Console.
X_BEARER_TOKEN=
# Optional. Added to the User-Agent sent to Wikimedia and others, as their policy asks
# (an email address or a URL where you can be reached).
THEIA_CONTACT=

# Optional language-model grouping trials. Keys stay server-side.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Anthropic remains the default; switch to openai to use GPT-6 Luna by default.
LLM_PROVIDER=anthropic
# Omit LLM_MODEL to use the provider default, or set a model ID.
# LLM_MODEL=gpt-6-luna
# Optional escalation for unsure assignments (may use the other provider).
# LLM_REVIEW_PROVIDER=openai
# LLM_REVIEW_MODEL=gpt-6.2-sol
# Optional OpenAI reasoning setting. Omit to use the model's default.
# OPENAI_REASONING_EFFORT=low
