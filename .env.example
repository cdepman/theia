# Server-side only. Never prefix any of these with VITE_ and never commit real values.

# Supabase project (Settings > API). The secret key starts with sb_secret_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# Not used by the app (the browser never talks to Supabase). Kept for reference.
SUPABASE_PUBLISHABLE_KEY=

# Access gate. Generate each with: openssl rand -base64 32
GATE_PASSWORD=
GATE_SIGNING_KEY=

# Shared secret between the scheduled dispatcher and the background worker.
WORKER_SECRET=

# Secret for the external freshness check (GitHub Actions calls /api/data-status with it).
STATUS_CHECK_SECRET=
